# Mật khẩu dùng cho MySQL trên môi trường phát triển Docker.
# Tạo .env từ tệp này và thay bằng mật khẩu riêng trước khi chạy.
MYSQL_PASSWORD=thay_mat_khau_ung_dung
AUTH_TOKEN_SECRET=thay_bang_chuoi_ngau_nhien_it_nhat_32_ky_tu
AUTH_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/v1/auth/google/callback
GOOGLE_ADMIN_REDIRECT_URI=http://127.0.0.1:8080/api/v1/auth/google/callback

# Brevo SMTP: copy SMTP login and SMTP key, not the API key.
# Other SMTP services are supported with their host and verified sender.
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
MYSQL_ROOT_PASSWORD=thay_mat_khau_root_khac

# Optional TiDB Cloud. Fill all four fields to select TiDB instead of local MySQL.
# Keep real credentials only in .env or the deployment platform's secret settings.
TIDB_HOST=
TIDB_PORT=4000
TIDB_USER=
TIDB_PASSWORD=
TIDB_DB_NAME=
# Optional custom CA file path inside the running container/server.
# Leave empty to verify certificates with the system CA trust store.
TIDB_CA_PATH=
